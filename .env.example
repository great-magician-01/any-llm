# any-llm configuration template
# Copy to .env, fill in your values, then restart service

# Listening port
ANY_LLM_PORT=6718

# Database type: sqlite (default) / postgres / mysql
DB_TYPE=sqlite

# SQLite database file path (used when DB_TYPE=sqlite)
ANY_LLM_DB_PATH=./any-llm.db

# PostgreSQL connection (used when DB_TYPE=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=amanuensis
# DB_SCHEMA=public

# MySQL connection (used when DB_TYPE=mysql; MySQL 8.0+)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=amanuensis
# DB_SCHEMA is ignored on MySQL: the database *is* the schema, so DB_NAME is it.
# MySQL requires max_allowed_packet >= 256M so a 64 MiB archived response_raw
# can still be written (OpenMySQL warns at startup when it is too small).

# Admin master password (for web UI login)
ANY_LLM_MASTER_PASSWORD=admin

# Session secret — keep this stable to persist logins across restarts
# Use a strong random string (e.g. openssl rand -hex 32)
# If left empty, a random secret is generated and saved to the file below,
# so logins survive restarts without setting anything.
ANY_LLM_SESSION_SECRET=

# File used to persist the auto-generated session secret
# (only used when ANY_LLM_SESSION_SECRET is empty)
# ANY_LLM_SESSION_SECRET_FILE=./.session-secret

# Admin login session expiry — Go duration (e.g. 24h, 168h) or plain hours
# (e.g. 24). 0 means never expire.
ANY_LLM_SESSION_TTL=24h

# Vendor balance/quota snapshot polling interval — Go duration (e.g. 10m, 30m)
# or plain hours. 0 disables all automatic fetching, including the boot-time
# snapshot (manual refresh via the admin API still works).
ANY_LLM_BALANCE_INTERVAL=10m

# Log file path — leave empty to log to stdout only
ANY_LLM_LOG_FILE=./logs/any-llm.log

# Log level: debug / info / warn / error
ANY_LLM_LOG_LEVEL=info
